Young Adult},
   ISSN = {1095-9572 (Electronic)
1053-8119 (Linking)},
   DOI = {10.1016/j.neuroimage.2010.06.029},
   url = {https://www.ncbi.nlm.nih.gov/pubmed/20558303},
   year = {2010},
