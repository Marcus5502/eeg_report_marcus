@article{gao2019,
   author = {Gao, C. and Conte, S. and Richards, J. E. and Xie, W. and Hanayik, T.},
   title = {The neural sources of {N170}: Understanding timing of activation in face-selective areas},
   journal = {Psychophysiology},
